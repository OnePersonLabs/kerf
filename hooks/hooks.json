{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/kerf-session-start.mjs\"",
            "timeout": 2,
            "additionalContextLimit": 512
          }
        ]
      }
    ]
  }
}
